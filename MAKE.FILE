CXX      := g++
CXXFLAGS := -std=c++11 -Wall -Iinclude
TARGET   := build/quanlychitieu
SRCDIR   := src
SRCS     := $(wildcard $(SRCDIR)/*.cpp)

.PHONY: all run clean

all: $(TARGET)

$(TARGET): $(SRCS)
	@mkdir -p build
	@mkdir -p data
	$(CXX) $(CXXFLAGS) $(SRCS) -o $(TARGET)
	@echo "==> Build thanh cong: $(TARGET)"

run: all
	./$(TARGET)

clean:
	rm -f $(TARGET)
	@echo "==> Da xoa file thuc thi."
